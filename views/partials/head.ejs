<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · 포트폴리오 DB</title>
  <script>
    /*
     * 저장된 테마를 그리기 전에 적용한다.
     * 이 스크립트가 없으면 라이트 모드 사용자에게 다크 화면이 한 번 번쩍인다.
     */
    (function () {
      try {
        var t = localStorage.getItem("theme");
        document.documentElement.setAttribute("data-theme", t === "light" ? "light" : "dark");
      } catch (e) {
        document.documentElement.setAttribute("data-theme", "dark");
      }
    })();
  </script>
  <link rel="stylesheet" href="/static/css/app.css">
  <link rel="stylesheet" href="/static/css/pages.css">
  <link rel="stylesheet" href="/static/css/matching.css">
  <link rel="stylesheet" href="/static/css/cover.css">
</head>
<body>
<% if (typeof nav === 'undefined' || nav) { %>
<header class="top">
  <div class="wrap">
    <a class="brand" href="/">포트폴리오<span>DB</span></a>
    <nav class="main">
      <a href="/" class="<%= path === '/' ? 'on' : '' %>">대시보드</a>
      <a href="/portfolio" class="<%= path.startsWith('/portfolio') ? 'on' : '' %>">포트폴리오</a>
      <a href="/profile" class="<%= path.startsWith('/profile') ? 'on' : '' %>">프로필</a>
      <a href="/matching" class="<%= path.startsWith('/matching') ? 'on' : '' %>">기업매칭</a>
      <a href="/search" class="<%= path === '/search' ? 'on' : '' %>">검색</a>
      <a href="/ask" class="<%= path === '/ask' ? 'on' : '' %>">질의응답</a>
      <a href="/docs" class="<%= path.startsWith('/doc') ? 'on' : '' %>">자료</a>
      <a href="/health" class="<%= path === '/health' ? 'on' : '' %>">수집상태</a>
    </nav>
    <div class="spacer"></div>
    <% if (typeof profiles !== 'undefined' && profiles.length > 1) { %>
      <form method="post" action="/profiles/switch" class="pswitch" title="보고 있는 프로필">
        <input type="hidden" name="back" value="<%= path %>">
        <select name="file" onchange="this.form.submit()" aria-label="프로필 선택">
          <% profiles.forEach(function (p) { %>
            <option value="<%= p.file %>" <%= p.current ? 'selected' : '' %>><%= p.name %></option>
          <% }) %>
        </select>
      </form>
    <% } %>
    <a href="/cover" class="navcta <%= path.startsWith('/cover') ? 'on' : '' %>">자기소개서</a>
    <button type="button" id="themeToggle" class="themebtn" aria-pressed="false"
            title="화면 모드 전환" aria-label="화면 모드 전환">
      <svg class="ic-moon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
        <path fill="currentColor" d="M20.7 14.6A8.6 8.6 0 0 1 9.4 3.3a1 1 0 0 0-1.3-1.2 10.6 10.6 0 1 0 13.8 13.8 1 1 0 0 0-1.2-1.3Z"/>
      </svg>
      <svg class="ic-sun" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2" fill="currentColor"/>
        <g stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
          <path d="M12 2.6v2.3M12 19.1v2.3M2.6 12h2.3M19.1 12h2.3M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"/>
        </g>
      </svg>
    </button>
    <span class="keytag <%= hasKey ? 'on' : '' %>"><%= hasKey ? 'AI 답변 켜짐' : '키워드 검색만' %></span>
  </div>
</header>
<% } %>
<div class="wrap">
