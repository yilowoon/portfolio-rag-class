# 포트
PORT=4300

# 로컬 전용 운영이면 비워두어도 됨(비면 로그인 없이 접근).
# 값을 넣으면 웹 접근 시 이 비밀번호를 요구한다.
APP_PASSWORD=
SESSION_SECRET=change-me

# 선택: Gemini 키가 있으면 (1) 벡터 임베딩 검색 (2) 질의응답 생성이 켜진다.
# 없으면 키워드(FTS5) 검색만으로 동작한다.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# OpenDART(금융감독원 전자공시) 오픈API 인증키 40자리.
# 발급·사용현황: https://opendart.fss.or.kr/mng/apiUsageStatusView.do
# 기업매칭용 기업 DB 를 만들 때만 쓴다. 하루 20,000건 제한.
DART_API_KEY=
