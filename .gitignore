node_modules/
.env
*.log

# SQLite 작업 파일
data/*.db
data/current.txt
data/*.db-*
data/cache/

# 각자의 프로필 원본 자료 — 개인정보가 들어가므로 저장소에 올리지 않는다
myprofile/*
!myprofile/.gitkeep

# 빈 폴더만 저장소에 남긴다 — 자료를 어디에 넣는지 보이도록.
# 폴더 자체를 먼저 되살린 다음 그 안을 다시 제외해야 한다.
# (제외된 폴더 안의 파일은 되살릴 수 없기 때문)
!myprofile/rawdata/
!myprofile/photos/
myprofile/rawdata/*
myprofile/photos/*
!myprofile/rawdata/.gitkeep
!myprofile/photos/.gitkeep

# 외부 도구용 내보내기 산출물 — 개인정보가 담기므로 올리지 않는다
deck/
