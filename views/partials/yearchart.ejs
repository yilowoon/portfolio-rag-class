<%
/*
 * 연도별 활동 분포 — 단일 계열 컬럼 차트.
 * locals: yc (src/portfolio.js 의 byYear() 결과)
 *
 * 계열이 하나라 범례는 두지 않는다(제목이 계열을 말해 준다).
 * 값은 막대마다 적지 않고 최다 연도만 직접 표기하며, 나머지는 축과 툴팁이 맡는다.
 */
var W = 640, H = 196;
var padL = 26, padR = 8, padT = 14, padB = 26;
var plotW = W - padL - padR;
var plotH = H - padT - padB;
var n = yc.data.length;
var step = plotW / n;
var barW = Math.max(3, step - 2); // 막대 사이 2px 간격
var max = Math.max(1, yc.max);
var ticks = [0, Math.ceil(max / 2), max];
var y = function (v) { return padT + plotH - (v / max) * plotH; };
var r = 4; // 막대 끝 둥글기
%>
<figure class="yc">
  <div class="yc-plot">
  <svg viewBox="0 0 <%= W %> <%= H %>" class="yc-svg" role="img"
       aria-label="연도별 활동 분포. <%= yc.from %>년부터 <%= yc.to %>년까지 활동 <%= yc.total %>건.">

    <!-- 눈금선: 실선 헤어라인 -->
    <% ticks.forEach(function (t) { %>
      <line x1="<%= padL %>" x2="<%= W - padR %>" y1="<%= y(t) %>" y2="<%= y(t) %>"
            stroke="var(--line)" stroke-width="1" />
      <text x="<%= padL - 6 %>" y="<%= y(t) + 4 %>" text-anchor="end"
            fill="var(--muted)" font-size="12" class="yc-tick"><%= t %></text>
    <% }) %>

    <!-- 막대 -->
    <% yc.data.forEach(function (d, i) {
         if (!d.count) return;
         var x = padL + i * step + (step - barW) / 2;
         var h = (d.count / max) * plotH;
         var top = padT + plotH - h;
         var rr = Math.min(r, h); %>
      <path class="yc-bar"
            d="M<%= x.toFixed(1) %>,<%= (top + h).toFixed(1) %>
               V<%= (top + rr).toFixed(1) %>
               Q<%= x.toFixed(1) %>,<%= top.toFixed(1) %> <%= (x + rr).toFixed(1) %>,<%= top.toFixed(1) %>
               H<%= (x + barW - rr).toFixed(1) %>
               Q<%= (x + barW).toFixed(1) %>,<%= top.toFixed(1) %> <%= (x + barW).toFixed(1) %>,<%= (top + rr).toFixed(1) %>
               V<%= (top + h).toFixed(1) %> Z">
        <title><%= d.year %>년 · 활동 <%= d.count %>건</title>
      </path>
    <% }) %>

    <!-- 최다 연도만 직접 표기 -->
    <% var pi = yc.data.findIndex(function (d) { return d.year === yc.peak.year; });
       if (pi >= 0) {
         var px = padL + pi * step + step / 2;
         var py = y(yc.peak.count) - 6; %>
      <text x="<%= px.toFixed(1) %>" y="<%= py.toFixed(1) %>" text-anchor="middle"
            fill="var(--text)" font-size="11.5" font-weight="600"><%= yc.peak.count %></text>
    <% } %>

    <!-- 기준선 -->
    <line x1="<%= padL %>" x2="<%= W - padR %>" y1="<%= y(0) %>" y2="<%= y(0) %>"
          stroke="var(--muted)" stroke-width="1" opacity="0.5" />

    <!-- 연도 축: 5년 단위 + 양 끝 -->
    <% yc.data.forEach(function (d, i) {
         // 양 끝 연도는 항상 적고, 그 바로 옆의 5년 눈금은 글자가 겹치므로 생략한다
         var isEnd = i === 0 || i === n - 1;
         var show = isEnd || (d.year % 5 === 0 && i > 2 && i < n - 3);
         if (!show) return;
         var x = padL + i * step + step / 2; %>
      <text x="<%= x.toFixed(1) %>" y="<%= H - 10 %>" text-anchor="middle"
            fill="var(--muted)" font-size="12" class="yc-tick"><%= d.year %></text>
    <% }) %>
  </svg>
  </div>

  <figcaption class="yc-cap">
    <%= yc.from %> – <%= yc.to %> · 활동 <b><%= yc.total %></b>건 ·
    가장 많았던 해 <b><%= yc.peak.year %></b>년(<%= yc.peak.count %>건)
  </figcaption>

  <details class="yc-table no-print">
    <summary>표로 보기</summary>
    <table>
      <tr><th>연도</th><th class="num">활동</th></tr>
      <% yc.data.filter(function (d) { return d.count; }).reverse().forEach(function (d) { %>
        <tr><td><%= d.year %></td><td class="num"><%= d.count %></td></tr>
      <% }) %>
    </table>
  </details>
</figure>
